---
// src/components/Footer.astro
const year = new Date().getFullYear();
const socials = [
  { href: 'https://github.com/LeonFroelje', label: 'GitHub' },
  { href: 'mailto:Leon@Froelje.dev', label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <p>© {year} Leon Frölje.</p>
    <ul>{socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--color-border); margin-top: 4rem; }
  .footer-inner {
    max-width: var(--wide-width); margin: 0 auto; padding: 2rem 1.5rem;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    color: var(--color-text-muted); font-size: 0.9rem;
  }
  ul { display: flex; gap: 1rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--color-text-muted); }
  a:hover { color: var(--color-text); }
</style>
