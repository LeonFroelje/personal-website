---
// src/pages/tags/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const docs = await getCollection('writing', ({ data }) => !data.draft);
const projects = await getCollection('projects');

const counts = new Map<string, number>();
for (const d of docs) for (const t of d.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
for (const p of projects) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);

const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---
<BaseLayout title="Tags">
  <section class="listing">
    <h1>Tags</h1>
    <ul class="tag-cloud">
      {tags.map(([tag, count]) => (
        <li><a href={`/tags/${tag}/`}>{tag}</a> <span>({count})</span></li>
      ))}
    </ul>
  </section>
</BaseLayout>
