---
// src/pages/tags/[tag].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const writing = await getCollection('writing', ({ data }) => !data.draft);
  const projects = await getCollection('projects');

  const tags = new Set([
    ...writing.flatMap((d) => d.data.tags),
    ...projects.flatMap((p) => p.data.tags),
  ]);

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      writing: writing.filter((d) => d.data.tags.includes(tag)),
      projects: projects.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag } = Astro.params;
const { writing, projects } = Astro.props;
---
<BaseLayout title={`Tag: ${tag}`}>
  <section class="listing">
    <h1>Tag: {tag}</h1>

    {projects.length > 0 && (
      <>
        <h2>Projects</h2>
        <ul>
          {projects.map((p) => <li><a href={`/projects/${p.id}/`}>{p.data.title}</a></li>)}
        </ul>
      </>
    )}

    {writing.length > 0 && (
      <>
        <h2>Writing</h2>
        <ul>
          {writing.map((d) => <li><a href={`/writing/${d.id}/`}>{d.data.title}</a></li>)}
        </ul>
      </>
    )}
  </section>
</BaseLayout>
