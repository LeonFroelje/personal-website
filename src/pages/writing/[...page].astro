---
// src/pages/writing/[...page].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const docs = (await getCollection('writing', ({ data }) => !data.draft))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
  return paginate(docs, { pageSize: 10 });
}

const { page } = Astro.props;
---
<BaseLayout title="Writing" description="Notes on math, computer science, and whatever else I'm building.">
  <section class="listing">
    <h1>Writing</h1>
    <ul>
      {page.data.map((doc) => (
        <a href={`/writing/${doc.id}`}>
          <li>
            <h2>{doc.data.title}</h2>
            {doc.data.date && <time>{doc.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>}
            {doc.data.description && <p>{doc.data.description}</p>}
          </li>
        </a>
      ))}
    </ul>
    <nav class="pager">
      {page.url.prev && <a href={page.url.prev}>← Newer</a>}
      <span>Page {page.currentPage} of {page.lastPage}</span>
      {page.url.next && <a href={page.url.next}>Older →</a>}
    </nav>
  </section>
</BaseLayout>
<style>
  
  .listing { max-width: var(--content-width); margin: 3rem auto; padding: 0 1.5rem; }
  ul { list-style: none; padding: 0; }
  ul a {
      /* .emph { */
      /*   color: var(--color-text); */
      /*   font-weight: bold; */
      /* } */
    text-decoration: none;
  }
  /* ul a::visited { */
  /*   text-decoration: none; */
  /* } */
  li { margin-top: .5rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
  li h2 { margin: 0; font-size: 1.1rem; font-weight: 600; text-decoration: none; color: var(--color-text); }
  li h2:hover { color: var(--color-accent); }
  time { display: block; font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.2rem; }
  li p { color: var(--color-text-muted); margin: 0.5rem 0 0; }
</style>
