---
// src/pages/writing/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---
<BaseLayout title="Writing" description="Notes on math, computer science, and whatever else I'm currently interested in.">
  <section class="listing">
    <h1>Writing</h1>
    <ul>
      {writing.map((doc) => (
        <li>
          <a href={`/writing/${doc.id}/`}>{doc.data.title}</a>
          {doc.data.date && (
            <time datetime={doc.data.date.toISOString()}>
              {doc.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          )}
          {doc.data.description && <p>{doc.data.description}</p>}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
<style>
  .listing { max-width: var(--content-width); margin: 3rem auto; padding: 0 1.5rem; }
  ul { list-style: none; padding: 0; }
  li { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
  li a { font-size: 1.1rem; font-weight: 600; text-decoration: none; color: var(--color-text); }
  li a:hover { color: var(--color-accent); }
  time { display: block; font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.2rem; }
  li p { color: var(--color-text-muted); margin: 0.5rem 0 0; }
</style>
